rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Anyone may leave feedback (short text only); nobody can read it except you in the Firebase console.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text','kind','page','label','topic','at'])
                    && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow read, update, delete: if false;
    }

    // Leaderboard: anyone can read; a signed-in (anonymous) browser can only touch its own player doc.
    match /players/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','total','week','weekId','updatedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
                    && request.resource.data.total == 0 && request.resource.data.week == 0;
      // Score can only go up, by at most 50 per write; the week score can never exceed the total.
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','total','week','weekId','updatedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
                    && request.resource.data.total >= resource.data.total
                    && request.resource.data.total - resource.data.total <= 50
                    && request.resource.data.week >= 0
                    && request.resource.data.week <= request.resource.data.total;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
