          "rows": [
            [
              "Aggregates duplicates?",
              "**No** — just reshapes",
              "**Yes** — combines duplicates using `aggfunc`"
            ],
            [
              "Duplicate index/column pair",
              "Raises an **error**",
              "Handled by the aggregation"
            ],
            [
              "Default aggregation",
              "None",
              "**mean**"
            ],
            [
              "Extra options",
